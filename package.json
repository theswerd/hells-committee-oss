{
  "name": "hells-committee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build && node scripts/build-worker.mjs",
    "dev:rooms": "node scripts/dev-room-server.mjs",
    "start": "wrangler pages dev dist/client --persist-to .wrangler/state --ip 127.0.0.1 --port 4174 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "sprites:sinners": "node sprites/generate-game-sinners.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/lilita-one": "^5.2.0",
    "@fontsource/space-mono": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "sharp": "^0.34.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.92.0"
  }
}
